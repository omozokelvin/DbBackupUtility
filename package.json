{
  "name": "db-backup-utility",
  "version": "1.0.0",
  "description": "A CLI utility for backing up and restoring databases",
  "main": "dist/index.js",
  "bin": {
    "db-backup": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest"
  },
  "keywords": ["database", "backup", "cli", "mysql", "postgresql", "mongodb", "sqlite"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "pg": "^8.13.0",
    "mysql2": "^3.9.7",
    "mongodb": "^6.8.0",
    "sql.js": "^1.10.3",
    "better-sqlite3": "^11.1.2",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1649.0",
    "winston": "^3.13.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/archiver": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/blessed": "0.1.24",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "@types/pg": "^8.11.6",
    "@types/mysql": "^2.15.26",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  }
}
